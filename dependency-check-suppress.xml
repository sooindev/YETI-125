<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dependency-Check 오탐 예외.

  스캐너는 파일 이름과 내용으로 라이브러리를 추측하기 때문에 엉뚱한 제품의
  취약점을 붙이는 일이 있다. 그런 것만 여기 적는다.

  규칙 하나마다 왜 해당되지 않는지 적어둔다. 근거 없는 예외는 스캔을
  통과시키려고 눈을 가리는 것과 같다.

  예:
    <suppress>
      <notes>이 앱은 STOMP/WebSocket 을 쓰지 않아 해당 없음</notes>
      <packageUrl regex="true">^pkg:maven/org\.springframework/spring\-webmvc@.*$</packageUrl>
      <cve>CVE-0000-00000</cve>
    </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
