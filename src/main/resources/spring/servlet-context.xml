<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- Enable MVC Annotation (@Controller, @RequestMapping 등) -->
    <mvc:annotation-driven validator="validator">
        <mvc:message-converters>
            <!-- JSON 변환 설정 (이모티콘 지원) -->
            <bean class="org.springframework.http.converter.json.MappingJackson2HttpMessageConverter">
                <property name="objectMapper" ref="objectMapper"/>
                <property name="supportedMediaTypes">
                    <list>
                        <value>application/json;charset=UTF-8</value>
                    </list>
                </property>
            </bean>
        </mvc:message-converters>
    </mvc:annotation-driven>

    <!--
      기본 메시지 보간기는 EL 구현체를 요구한다. 톰캣 EL 에 끌려다니지 않도록
      EL 없는 보간기를 쓴다. {min} 치환은 되고 ${...} 표현식만 못 쓴다.
    -->
    <bean id="validator" class="org.springframework.validation.beanvalidation.LocalValidatorFactoryBean">
        <property name="messageInterpolator">
            <bean class="org.hibernate.validator.messageinterpolation.ParameterMessageInterpolator"/>
        </property>
    </bean>

    <!-- ObjectMapper 설정 (이모티콘 출력 지원) -->
    <bean id="objectMapper" class="org.springframework.http.converter.json.Jackson2ObjectMapperFactoryBean">
        <!--
          ScheduleVO 의 @JsonFormat 과 같은 모양('T' 구분)으로 맞춘다.
          목록 API 는 VO 가 아니라 Map 을 내보내 애너테이션을 타지 않으므로,
          여기가 어긋나면 같은 일정이 주소에 따라 두 형식으로 나간다.

          시간대를 비워두면 JVM 기본값을 따라간다 — 서버 시간대가 바뀌면
          @JsonFormat(Asia/Seoul) 쪽과 조용히 어긋나므로 여기서도 못 박는다.
        -->
        <property name="dateFormat">
            <bean class="java.text.SimpleDateFormat">
                <constructor-arg value="yyyy-MM-dd'T'HH:mm:ss"/>
                <property name="timeZone">
                    <bean class="java.util.TimeZone" factory-method="getTimeZone">
                        <constructor-arg value="Asia/Seoul"/>
                    </bean>
                </property>
            </bean>
        </property>
        <property name="featuresToDisable">
            <list>
                <bean class="org.springframework.beans.factory.config.FieldRetrievingFactoryBean">
                    <property name="staticField" value="com.fasterxml.jackson.core.JsonGenerator.Feature.ESCAPE_NON_ASCII"/>
                </bean>
            </list>
        </property>
    </bean>

    <!-- Component Scan (Controller Only) -->
    <context:component-scan base-package="com.irion" use-default-filters="false">
        <context:include-filter type="annotation" expression="org.springframework.stereotype.Controller"/>
    </context:component-scan>

    <!-- Static Resources (css, js, images) -->
    <mvc:resources mapping="/resources/**" location="/resources/"/>

    <!-- View Resolver (JSP) -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
        <property name="contentType" value="text/html; charset=UTF-8"/>
    </bean>

    <!-- Interceptors -->
    <mvc:interceptors>
        <!-- 관리자 로그인 체크 -->
        <mvc:interceptor>
            <mvc:mapping path="/admin/**"/>
            <!-- 로그인 페이지가 자기 자신에게 막히면 무한 리다이렉트가 된다 -->
            <mvc:exclude-mapping path="/admin/admin-login"/>
            <mvc:exclude-mapping path="/admin/loginProc"/>
            <bean class="com.irion.common.interceptor.AdminLoginInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

    <!-- Default Servlet Handler -->
    <mvc:default-servlet-handler/>

</beans>