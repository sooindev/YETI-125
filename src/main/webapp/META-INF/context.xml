<?xml version="1.0" encoding="UTF-8"?>
<!--
  세션 쿠키의 SameSite. Servlet 4.0 의 <cookie-config> 에 항목이 없어
  톰캣 쿠키 처리기로 붙인다.

  Lax 면 다른 사이트에서 온 POST 에 세션 쿠키가 실리지 않아 CsrfFilter 와
  겹겹이 막는 셈이 된다. 링크 클릭으로 들어오는 GET 은 그대로 동작한다.
-->
<Context>
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor"
                     sameSiteCookies="lax"/>
</Context>
