<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Irion Fansite</display-name>

  <!-- Root Spring Container -->
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>classpath:spring/root-context.xml</param-value>
  </context-param>

  <listener>
    <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
  </listener>

  <!-- Character Encoding Filter (한글 처리) -->
  <filter>
    <filter-name>encodingFilter</filter-name>
    <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
    <init-param>
      <param-name>forceEncoding</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>encodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Static Resource Encoding Filter (이모티콘 지원) -->
  <filter>
    <filter-name>staticResourceEncodingFilter</filter-name>
    <filter-class>com.irion.common.filter.StaticResourceEncodingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>staticResourceEncodingFilter</filter-name>
    <url-pattern>/resources/*</url-pattern>
  </filter-mapping>

  <!-- Static Resource Cache Filter (배포 후 낡은 CSS/JS 방지) -->
  <filter>
    <filter-name>staticResourceCacheFilter</filter-name>
    <filter-class>com.irion.common.filter.StaticResourceCacheFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>staticResourceCacheFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Spring MVC DispatcherServlet -->
  <servlet>
    <servlet-name>dispatcher</servlet-name>
    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
    <init-param>
      <param-name>contextConfigLocation</param-name>
      <param-value>classpath:spring/servlet-context.xml</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>dispatcher</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>

  <!-- Session Config (30분) -->
  <session-config>
    <session-timeout>30</session-timeout>

    <!--
      세션 쿠키 보호.

        http-only : 스크립트가 document.cookie 로 세션 ID 를 읽지 못한다.
        secure    : 평문 HTTP 로는 쿠키를 보내지 않는다. 운영은 HTTPS 다.
                    로컬(http://localhost:8080)은 크롬/파이어폭스가 localhost 를
                    신뢰할 수 있는 출처로 보아 그대로 동작하지만, 사파리에서는
                    관리자 로그인이 유지되지 않는다.

      SameSite 는 Servlet 4.0 스펙에 없어서 META-INF/context.xml 에 둔다.
    -->
    <cookie-config>
      <http-only>true</http-only>
      <secure>true</secure>
    </cookie-config>
  </session-config>

  <!-- Error Pages -->
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/common/404.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/common/500.jsp</location>
  </error-page>

  <filter>
    <filter-name>adminLoginFilter</filter-name>
    <filter-class>com.irion.common.filter.AdminLoginFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>adminLoginFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <!--
    CSRF 검사 (관리자 영역의 상태 변경 요청)

    adminLoginFilter 다음에 매핑한다. 로그인 여부를 먼저 가린 뒤,
    로그인한 요청에 대해서만 토큰을 따진다.
  -->
  <filter>
    <filter-name>csrfFilter</filter-name>
    <filter-class>com.irion.common.filter.CsrfFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>csrfFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

</web-app>