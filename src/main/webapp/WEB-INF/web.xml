<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Irion Fansite</display-name>

  <!-- Root Spring Container -->
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>classpath:spring/root-context.xml</param-value>
  </context-param>

  <listener>
    <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
  </listener>

  <!-- Character Encoding Filter (한글 처리) -->
  <filter>
    <filter-name>encodingFilter</filter-name>
    <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
    <init-param>
      <param-name>forceEncoding</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>encodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Static Resource Encoding Filter (이모티콘 지원) -->
  <filter>
    <filter-name>staticResourceEncodingFilter</filter-name>
    <filter-class>com.irion.common.web.filter.StaticResourceEncodingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>staticResourceEncodingFilter</filter-name>
    <url-pattern>/resources/*</url-pattern>
  </filter-mapping>

  <!-- Static Resource Cache Filter (배포 후 낡은 CSS/JS 방지) -->
  <filter>
    <filter-name>staticResourceCacheFilter</filter-name>
    <filter-class>com.irion.common.web.filter.StaticResourceCacheFilter</filter-class>
  </filter>
  <!--
    ERROR 를 함께 적는 이유 — 필터 기본값은 REQUEST 뿐이라 404·500 응답에는
    이 필터가 돌지 않았다. 그 두 페이지만 CSP 도 X-Frame-Options 도 없이 나갔다.

    REQUEST 도 같이 적어야 한다 — <dispatcher> 를 하나라도 쓰면 기본값이 사라진다
  -->
  <filter-mapping>
    <filter-name>staticResourceCacheFilter</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
    <dispatcher>ERROR</dispatcher>
  </filter-mapping>

  <!-- 옛 .html → 정규 주소 301. 보안 헤더 뒤, 로그인 검사 앞 -->
  <filter>
    <filter-name>legacyHtmlRedirectFilter</filter-name>
    <filter-class>com.irion.common.web.filter.LegacyHtmlRedirectFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>legacyHtmlRedirectFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- 내려둔 화면(3주년 방명록) 차단. 되살릴 때는 이 두 덩이를 제거 -->
  <filter>
    <filter-name>closedPageFilter</filter-name>
    <filter-class>com.irion.common.web.filter.ClosedPageFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>closedPageFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Spring MVC DispatcherServlet -->
  <servlet>
    <servlet-name>dispatcher</servlet-name>
    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
    <init-param>
      <param-name>contextConfigLocation</param-name>
      <param-value>classpath:spring/servlet-context.xml</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>dispatcher</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>

  <!-- Session Config (30분) -->
  <session-config>
    <session-timeout>30</session-timeout>

    <!-- SameSite 는 스펙에 없어 META-INF/context.xml 에 있다.
      secure 때문에 로컬 http 사파리에서는 관리자 로그인이 유지되지 않는다 -->
    <cookie-config>
      <http-only>true</http-only>
      <secure>true</secure>
    </cookie-config>

    <!-- 톰캣 기본값(COOKIE+URL)은 주소에 ;jsessionid= 를 붙인다 — 공유되면 세션이 넘어간다.
      스키마상 cookie-config 다음 -->
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- Error Pages -->
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error/404.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/error/500.jsp</location>
  </error-page>
  <!--
    503 도 같은 화면. 500.jsp 는 "일시적인 오류" 에 "다시 시도" 링크라
    클립 상세의 503(목록 미완성)에 맞는다. 빼면 톰캣 기본 화면이 나간다
  -->
  <error-page>
    <error-code>503</error-code>
    <location>/WEB-INF/views/error/500.jsp</location>
  </error-page>

  <!--
    로그인 빈도 제한. adminLoginFilter 앞에 둔다 — /admin/loginProc 은 그 필터의
    공개 경로라 뒤에 두면 얻는 것이 없다. 1차는 nginx 의 limit_req(config/nginx)
  -->
  <filter>
    <filter-name>loginRateLimitFilter</filter-name>
    <filter-class>com.irion.common.web.filter.LoginRateLimitFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>loginRateLimitFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>adminLoginFilter</filter-name>
    <filter-class>com.irion.common.web.filter.AdminLoginFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>adminLoginFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <!-- CSRF 검사. adminLoginFilter 다음이라 로그인 여부를 먼저 가린다 -->
  <filter>
    <filter-name>csrfFilter</filter-name>
    <filter-class>com.irion.common.web.filter.CsrfFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>csrfFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

</web-app>